# ── App ──
APP_ENV=development
APP_PORT=8080

# ── Database (PostgreSQL) ──
DB_DSN=host=localhost user=postgres password=postgres dbname=smart_ledger port=5432 sslmode=disable timezone=Asia/Jakarta

# ── WAHA (WhatsApp HTTP API) ──
WAHA_BASE_URL=http://localhost:3000
WAHA_SESSION=default
# Isi dengan WAHA_API_KEY yang sama yang dipakai container WAHA.
# Wajib agar SendText terauth (header X-Api-Key).
WAHA_API_KEY=
# Token bebas untuk mengamankan endpoint webhook kita.
WAHA_WEBHOOK_TOKEN=changeme
# Kredensial dashboard WAHA (http://localhost:3000/dashboard).
WAHA_DASHBOARD_PASSWORD=admin

# ── LLM (DeepSeek API langsung / OpenRouter) ──
# Opsi 1: DeepSeek API langsung (rekomen, lebih stabil & murah)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

# Opsi 2: Via OpenRouter (fallback)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-xxx
# LLM_MODEL=deepseek/deepseek-chat
